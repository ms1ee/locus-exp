diff --git a/src/paf.c b/src/paf.c
index a3ce23e0..a698ceb2 100644
--- a/src/paf.c
+++ b/src/paf.c
@@ -24,6 +24,7 @@
 #include <string.h>
 #include <ctype.h>
 #include <math.h>
+#include <unistd.h> /* Locus: for _exit */
 
 #include "sndfile.h"
 #include "sfendian.h"
@@ -109,6 +110,7 @@ paf_open	(SF_PRIVATE *psf)
 			return error ;
 		} ;
 
+
 	subformat = SF_CODEC (psf->sf.format) ;
 
 	if (psf->file.mode == SFM_WRITE || psf->file.mode == SFM_RDWR)
@@ -178,6 +180,10 @@ paf_read_header	(SF_PRIVATE *psf)
 	else
 		return SFE_PAF_NO_MARKER ;
 
+	// Locus: Format/type validation dimension - canary is only reachable when
+	// the file signature matches the PAF or FAP marker.
+	if (marker != PAF_MARKER && marker != FAP_MARKER) _exit (1) ;
+
 	psf_log_printf (psf, "Version     : %d\n", paf_fmt.version) ;
 
 	if (paf_fmt.version != 0)
@@ -185,6 +191,11 @@ paf_read_header	(SF_PRIVATE *psf)
 		return SFE_PAF_VERSION ;
 		} ;
 
+	// Locus: Value range dimension - canary is only reachable when the PAF
+	// header version field is zero.
+	if (paf_fmt.version != 0) _exit (1) ;
+
+
 	psf_log_printf (psf, "Sample Rate : %d\n", paf_fmt.samplerate) ;
 	psf_log_printf (psf, "Channels    : %d\n", paf_fmt.channels) ;
 
diff --git a/src/sndfile.c b/src/sndfile.c
index 365c1361..be06b403 100644
--- a/src/sndfile.c
+++ b/src/sndfile.c
@@ -3114,6 +3114,17 @@ psf_open_file (SF_PRIVATE *psf, SF_INFO *sfinfo)
 			psf->sf.format = format_from_extension (psf) ;
 		} ;
 
+	// Locus: Control flow + Size dimensions (moved upstream from the
+	// SF_FORMAT_PAF dispatch case) - as soon as the container format is
+	// known to be PAF, the PAF canary is only reachable when the file is
+	// opened for reading (or RDWR with existing content) and is large
+	// enough to hold a full PAF header (PAF_HEADER_LENGTH == 2048 bytes).
+	if ((SF_CONTAINER (psf->sf.format)) == SF_FORMAT_PAF)
+	{	if (!(psf->file.mode == SFM_READ || (psf->file.mode == SFM_RDWR && psf->filelength > 0))) _exit (1) ;
+		if ((psf->file.mode == SFM_READ || (psf->file.mode == SFM_RDWR && psf->filelength > 0)) && psf->filelength < 2048) _exit (1) ;
+		} ;
+
+
 	/* Prevent unnecessary seeks */
 	psf->last_op = psf->file.mode ;
 
