diff --git a/src/paf.c b/src/paf.c
index a3ce23e0..9d758162 100644
--- a/src/paf.c
+++ b/src/paf.c
@@ -24,6 +24,7 @@
 #include <string.h>
 #include <ctype.h>
 #include <math.h>
+#include <unistd.h> // Locus: for _exit
 
 #include "sndfile.h"
 #include "sfendian.h"
@@ -104,6 +105,11 @@ paf_open	(SF_PRIVATE *psf)
 
  	psf->dataoffset = PAF_HEADER_LENGTH ;
 
+	// Locus: [control_flow] necessary condition - the canary in paf_read_header is only
+	// reachable when the file is actually opened for reading (or RDWR with existing data)
+	if (!(psf->file.mode == SFM_READ || (psf->file.mode == SFM_RDWR && psf->filelength > 0)))
+		_exit (1) ;
+
 	if (psf->file.mode == SFM_READ || (psf->file.mode == SFM_RDWR && psf->filelength > 0))
 	{	if ((error = paf_read_header (psf)))
 			return error ;
@@ -159,6 +165,10 @@ paf_read_header	(SF_PRIVATE *psf)
 {	PAF_FMT		paf_fmt ;
 	int			marker ;
 
+	// Locus: [size_length] necessary condition - header must be fully present in file
+	if (psf->filelength < PAF_HEADER_LENGTH)
+		_exit (1) ;
+
 	if (psf->filelength < PAF_HEADER_LENGTH)
 		return SFE_PAF_SHORT_HEADER ;
 
@@ -176,12 +186,17 @@ paf_read_header	(SF_PRIVATE *psf)
 			&(paf_fmt.samplerate), &(paf_fmt.format), &(paf_fmt.channels), &(paf_fmt.source)) ;
 		}
 	else
+	{	// Locus: [format_validation] necessary condition - marker must be a recognised PAF/FAP signature
+		_exit (1) ;
 		return SFE_PAF_NO_MARKER ;
+		} ;
 
 	psf_log_printf (psf, "Version     : %d\n", paf_fmt.version) ;
 
 	if (paf_fmt.version != 0)
 	{	psf_log_printf (psf, "*** Bad version number. should be zero.\n") ;
+		// Locus: [value_range_version] necessary condition - header version field must be zero
+		_exit (1) ;
 		return SFE_PAF_VERSION ;
 		} ;
 
